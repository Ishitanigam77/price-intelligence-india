# PriceRadar India — Example environment configuration
#
# Copy this file to `.env` for local development and fill in real values there.
# NEVER commit a real `.env` file. NEVER put real secrets in this file.
# In deployed environments, these values are sourced from Azure Key Vault via
# managed identity, not from a committed .env file.
#
# This file documents the environment variables the system is expected to need
# as later phases introduce the corresponding functionality. Variables are
# grouped by the phase/component that will consume them; not all of them are
# in use yet.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Backend API (FastAPI)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — introduced in Phase 1
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=priceradar
POSTGRES_USER=priceradar_app
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg2://priceradar_app:changeme@localhost:5432/priceradar

# ---------------------------------------------------------------------------
# Redis (cache + Celery broker/result backend) — introduced in Phase 2
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# Authentication (Clerk) — introduced in Phase 5
# ---------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# ---------------------------------------------------------------------------
# Retailer Adapters — introduced in Phase 2 (per-retailer credentials will be
# added alongside each retailer's adapter, never speculatively)
# ---------------------------------------------------------------------------
# RETAILER_<NAME>_API_KEY=
# RETAILER_<NAME>_API_BASE_URL=
# RETAILER_<NAME>_AFFILIATE_ID=

# ---------------------------------------------------------------------------
# Machine Learning — introduced in Phase 8
# ---------------------------------------------------------------------------
ML_MODEL_ARTIFACT_PATH=

# ---------------------------------------------------------------------------
# Azure Infrastructure — introduced in Phase 11
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_KEY_VAULT_URL=
AZURE_CONTAINER_REGISTRY_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
