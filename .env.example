# PriceRadar India — Example environment configuration
#
# Copy this file to `.env` for local development and fill in real values there.
# NEVER commit a real `.env` file. NEVER put real secrets in this file.
# In deployed environments, these values are sourced from Azure Key Vault via
# managed identity, not from a committed .env file.
#
# This file documents the environment variables the system is expected to need
# as later phases introduce the corresponding functionality. Variables are
# grouped by the phase/component that will consume them; not all of them are
# in use yet.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# LOG_FORMAT=json is recommended for containerized/cloud deployments; use "text" for a more
# human-readable console format during local development.
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Backend API (FastAPI) — application factory/CORS introduced in Phase 2
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed browser origins. Never use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — introduced in Phase 1
# ---------------------------------------------------------------------------
# DATABASE_URL is what the backend actually reads (see backend/app/core/config.py); the
# POSTGRES_* variables are provided for convenience/documentation and for tooling (e.g. psql,
# docker compose) that expects them individually. Uses the psycopg (v3) driver.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=priceradar
POSTGRES_USER=priceradar_app
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg://priceradar_app:changeme@localhost:5432/priceradar

# Connection pool sizing (see backend/app/db/session.py) — introduced in Phase 2.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Used only by backend/tests/integration — a separate database so tests never touch dev data.
TEST_DATABASE_URL=postgresql+psycopg://priceradar_app:changeme@localhost:5432/priceradar_test

# Whether the backend container applies Alembic migrations on startup (see
# backend/docker-entrypoint.sh). Convenient for local Docker Compose; set to "false" in real
# deployments where migrations run as their own release step.
RUN_DB_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Redis (infrastructure only in Phase 2: connection/client + health check; caching business
# logic, Celery broker usage, queues, and distributed locks are introduced in later phases)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# Authentication (Clerk) — introduced in Phase 5
# ---------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# ---------------------------------------------------------------------------
# Retailer Adapters — framework introduced in Phase 2
# ---------------------------------------------------------------------------
# Framework-wide defaults applied to every adapter that does not override them
# (see backend/app/retailer_adapters/base/config.py). Deliberately conservative.
RETAILER_ADAPTER_DEFAULT_TIMEOUT_SECONDS=10.0
RETAILER_ADAPTER_DEFAULT_MAX_ATTEMPTS=3
RETAILER_ADAPTER_DEFAULT_REQUESTS_PER_MINUTE=60
RETAILER_ADAPTER_DEFAULT_MAX_CONCURRENT_REQUESTS=1

# Comma-separated retailer IDs to switch off globally (an operational kill switch;
# overrides each adapter's own enabled flag). Example: mock-retailer-a,mock-retailer-b
RETAILER_ADAPTERS_DISABLED=

# Which adapter kinds to instantiate at API startup (`mock`, `integration`, or both).
# Product discovery currently uses the fixture-backed mock adapters only.
RETAILER_ADAPTER_KINDS=mock

# Per-retailer overrides. <ID> is the retailer's ID upper-cased with hyphens replaced
# by underscores, e.g. RETAILER_MOCK_RETAILER_A_ENABLED for "mock-retailer-a".
# RETAILER_<ID>_ENABLED=
# RETAILER_<ID>_TIMEOUT_SECONDS=
# RETAILER_<ID>_MAX_ATTEMPTS=
# RETAILER_<ID>_REQUESTS_PER_MINUTE=
# RETAILER_<ID>_MAX_CONCURRENT_REQUESTS=

# Per-retailer credentials are added alongside each real retailer's adapter, never
# speculatively, and are read from the environment / Azure Key Vault by that adapter.
# They are never stored in an adapter's configuration object.
# RETAILER_<ID>_API_KEY=
# RETAILER_<ID>_API_BASE_URL=
# RETAILER_<ID>_AFFILIATE_ID=

# ---------------------------------------------------------------------------
# Product matching — introduced in this increment (identity / matching engine)
# ---------------------------------------------------------------------------
# Embedding backend: `hashing` (default, no model download) or `sentence_transformers`.
# The Sentence Transformer model name is not a secret. If a private model hub token is
# required in a deployed environment, supply it via Key Vault / env (e.g. HF_TOKEN) —
# never commit it here.
MATCHING_EMBEDDING_BACKEND=hashing
MATCHING_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MATCHING_EMBEDDING_DIMENSION=256
MATCHING_EMBEDDING_CACHE_SIZE=2048
MATCHING_TITLE_HIGH_THRESHOLD=0.82
MATCHING_TITLE_MEDIUM_THRESHOLD=0.60
MATCHING_EMBEDDING_HIGH_THRESHOLD=0.86
MATCHING_EMBEDDING_MEDIUM_THRESHOLD=0.72
MATCHING_SAME_PRODUCT_MIN_SCORE=0.78
MATCHING_POSSIBLE_MATCH_MIN_SCORE=0.52
MATCHING_NEEDS_REVIEW_MIN_SCORE=0.34

# ---------------------------------------------------------------------------
# Price comparison — introduced in Phase 6
# ---------------------------------------------------------------------------
# Observation age (hours) used to classify data freshness. These are not secrets.
PRICING_FRESH_WITHIN_HOURS=6
PRICING_STALE_AFTER_HOURS=24
# Historical intelligence (Phase 7). Thresholds only — not secrets.
PRICING_TREND_STABLE_PERCENT=2.0
PRICING_MIN_OBSERVATIONS_FOR_AVERAGE=1
PRICING_MIN_OBSERVATIONS_FOR_EXTREMA=1
PRICING_MIN_OBSERVATIONS_FOR_VOLATILITY=2
PRICING_MIN_OBSERVATIONS_FOR_PERCENTILE=2
PRICING_MIN_OBSERVATIONS_FOR_TREND=2

# ---------------------------------------------------------------------------
# Sale-event intelligence — Phase 9
# ---------------------------------------------------------------------------
# Detection/history thresholds only — not secrets. Detection infers generic windows from
# stored price observations; it never invents named real-world sale campaigns.
SALES_DROP_PERCENT_THRESHOLD=10.0
SALES_MIN_LISTINGS_FOR_DETECTION=2
SALES_MAX_GAP_DAYS=2
SALES_MIN_OBSERVATIONS_FOR_SALE_STATS=1
SALES_HIGH_CONFIDENCE_LISTING_COUNT=5
SALES_MEDIUM_CONFIDENCE_LISTING_COUNT=2

# ---------------------------------------------------------------------------
# Machine Learning — introduced in Phase 8
# ---------------------------------------------------------------------------
ML_MODEL_ARTIFACT_PATH=

# ---------------------------------------------------------------------------
# Azure Infrastructure — introduced in Phase 11
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_KEY_VAULT_URL=
AZURE_CONTAINER_REGISTRY_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
