# Frontend environment (Next.js). Copy to `.env.local` for local development.
# NEVER put real secrets in this file. The browser only receives NEXT_PUBLIC_* values.

# Backend origin used by the typed API client. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk — publishable key is the only Clerk value the browser may receive.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Server-only. Used by Clerk's Next.js middleware. NEVER prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Observability (Phase 16). Server-only Application Insights connection string.
# Do not prefix with NEXT_PUBLIC_ — the browser never receives it.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# ENVIRONMENT=development
